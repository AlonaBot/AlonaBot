const scenarioRecoveryProbeSource = `package main
import("fmt";"encoding/json";"log/slog";"net/http";"os";"time";"github.com/AlonaBot/AlonaBot/sdk";"github.com/AlonaBot/AlonaBot/sdk/genimpl";"github.com/AlonaBot/AlonaBot/sdk/service";"github.com/AlonaBot/AlonaBot/sdk/bus")
type gateArgs struct{}
func init(){genimpl.Register("main",genimpl.Resources{ServiceSchemas:map[string][]byte{"main.gateArgs":[]byte("{\"type\":\"object\"}")}})}
func main(){p:=sdk.NewPlugin()
 p.Every("clock",time.Second).Handle(func(*sdk.Context)error{if err:=os.WriteFile("clock.next",[]byte(fmt.Sprint(time.Now().UnixMilli())),0600);err!=nil{return err};return os.Rename("clock.next","clock")})
 for _,action:=range []string{"service","bus"}{p.Route("POST","/"+action).HandleFunc(func(w http.ResponseWriter,r *http.Request){
  f,err:=os.OpenFile("attempts",os.O_CREATE|os.O_APPEND|os.O_WRONLY,0600);if err!=nil{http.Error(w,err.Error(),500);return};_,err=fmt.Fprintln(f,action);closeErr:=f.Close();if err!=nil{http.Error(w,err.Error(),500);return};if closeErr!=nil{http.Error(w,closeErr.Error(),500);return}
  if action=="service"{_,err=service.JSON[gateArgs,gateArgs]("recovery/gate").Call(r.Context(),gateArgs{})}else{_,err=bus.Define[gateArgs]("gateprobe/pulse").Publish(r.Context(),gateArgs{})}
  result:="";if err!=nil{result=err.Error()};if err:=json.NewEncoder(w).Encode(map[string]string{"error":result});err!=nil{slog.Error("write probe","error",err)}
 })}
 if err:=sdk.Run(p);err!=nil{slog.Error("probe failed","error",err);os.Exit(1)}
}`

func scenarioRecoveryCandidateGates(t *testing.T, binary, archive, probe, phase string) {
	t.Helper()
	dir := scenarioRecoveryDirectory(t, "gates-"+phase)
	pluginDir := filepath.Join(dir, "plugins", "recovery")
	probeDir := filepath.Join(dir, "plugins", "gateprobe")
	c := scenarioRecoveryStart(t, binary, dir, "")
	adapter := os.Getenv("ALONABOT_SCENARIO_ADAPTER_PACKAGE")
	scenarioManagement(t, c, dir, "", "install", adapter, "--yes")
	scenarioManagement(t, c, dir, "", "adapter", "instance", "create", "alonabot-adapter-fixture", "one")
	scenarioManagement(t, c, dir, "", "enable", "alonabot-adapter-fixture")
	scenarioManagement(t, c, dir, "", "install", probe, "--yes")
	scenarioManagement(t, c, dir, "", "enable", "gateprobe")
	scenarioManagement(t, c, dir, "", "install", archive, "--yes")
	scenarioManagement(t, c, dir, "", "enable", "recovery")
	scenarioRecoveryWrite(t, filepath.Join(pluginDir, "config.json"), "{}")
	old := scenarioPackage(t, c, dir, "recovery").Active
	// 1. 同一套驱动先证明六类入口在正常绑定后都实际执行。
	drive := func() {
		t.Helper()
		for _, text := range []string{"/gate", "ordinary event"} {
			if status, raw := scenarioHTTP(t, c, dir, http.MethodPost, "/plugins/alonabot-adapter-fixture/deliver?instance=one&user=alice&text="+url.QueryEscape(text)); status != 204 {
				t.Fatalf("deliver: %d %s", status, raw)
			}
		}
		for _, action := range []string{"service", "bus"} {
			if status, raw := scenarioHTTP(t, c, dir, http.MethodPost, "/plugins/gateprobe/"+action); status != 200 || strings.TrimSpace(string(raw)) != `{"error":""}` {
				t.Fatalf("%s: %d %s", action, status, raw)
			}
		}
		scenarioRecoveryValue(t, c, dir, "1", false)
	}
	kinds := func() map[string]string {
		t.Helper()
		result := map[string]string{}
		for _, line := range strings.Split(string(scenarioRecoveryRead(t, filepath.Join(pluginDir, "requests"))), "\n") {
			if fields := strings.Fields(line); len(fields) == 2 {
				result[fields[1]] = fields[0]
			}
		}
		return result
	}
	drive()
	recoveryWait(t, func() bool { return len(kinds()) == 6 })
	stopTestCore(t, c)
	scenarioRecoveryReleasePipe(t, dir)
	c = scenarioRecoveryStart(t, binary, dir, phase)
	c.waitFor(`"msg":"plugin activated".*"plugin_id":"recovery"`)
	reload := scenarioRecoveryStartCommand(t, recoveryCommand(t, c, dir, "reload", "recovery"))
	scenarioRecoveryWaitFile(t, filepath.Join(dir, "checkpoint"))
	before := string(scenarioRecoveryRead(t, filepath.Join(pluginDir, "requests")))
	attempts := strings.Fields(string(scenarioRecoveryRead(t, filepath.Join(probeDir, "attempts"))))
	// 2. 精确检查点保持候选未绑定；异步请求允许门禁选择等待或拒绝。
	type response struct {
		status int
		body   []byte
	}
	requests := make([]chan response, 0, 5)
	for _, request := range [][2]string{
		{http.MethodPost, "/plugins/alonabot-adapter-fixture/deliver?instance=one&user=alice&text=%2Fgate"},
		{http.MethodPost, "/plugins/alonabot-adapter-fixture/deliver?instance=one&user=alice&text=ordinary"},
		{http.MethodPost, "/plugins/gateprobe/service"},
		{http.MethodPost, "/plugins/gateprobe/bus"},
		{http.MethodGet, "/plugins/recovery/value"},
	} {
		done := make(chan response, 1)
		requests = append(requests, done)
		go func() {
			defer close(done)
			status, body := scenarioHTTP(t, c, dir, request[0], request[1])
			done <- response{status, body}
		}()
	}
	recoveryWait(t, func() bool {
		return len(strings.Fields(string(scenarioRecoveryRead(t, filepath.Join(probeDir, "attempts"))))) >= len(attempts)+2
	})
	scenarioRecoveryWaitFile(t, filepath.Join(probeDir, "clock"))
	clock, err := strconv.ParseInt(string(scenarioRecoveryRead(t, filepath.Join(probeDir, "clock"))), 10, 64)
	if err != nil {
		t.Fatal(err)
	}
	// 以独立插件的真实定时回调推进至少一个候选任务周期，避免固定 sleep 猜测门禁窗口。
	recoveryWait(t, func() bool {
		next, err := strconv.ParseInt(string(scenarioRecoveryRead(t, filepath.Join(probeDir, "clock"))), 10, 64)
		if err != nil {
			t.Fatal(err)
		}
		return next >= clock+1000
	})
	if after := string(scenarioRecoveryRead(t, filepath.Join(pluginDir, "requests"))); after != before {
		t.Fatalf("candidate served before binding at %s: %q -> %q", phase, before, after)
	}
	scenarioRecoveryRelease(t, dir)
	if result := reload.wait(t); result.err != nil {
		t.Fatalf("gate reload: %v %s\n%s", result.err, result.output, c.log())
	}
	for _, done := range requests {
		var result response
		recoveryWait(t, func() bool {
			select {
			case result = <-done:
				return true
			default:
				return false
			}
		})
		t.Logf("held %s response: %d %s", phase, result.status, result.body)
	}
	// 3. 完整绑定后六类入口均交给新进程，旧进程不再接单。
	item := scenarioPackage(t, c, dir, "recovery")
	if item.Active == old || item.State != "Activated" {
		t.Fatalf("bound candidate: %+v", item)
	}
	drive()
	pid := strings.Fields(string(scenarioRecoveryRead(t, filepath.Join(pluginDir, "starts"))))
	wantPID := pid[len(pid)-1]
	recoveryWait(t, func() bool {
		current := kinds()
		for _, kind := range []string{"command", "event", "service", "bus", "job", "http"} {
			if current[kind] != wantPID {
				return false
			}
		}
		return true
	})
	for _, line := range strings.Split(strings.TrimPrefix(string(scenarioRecoveryRead(t, filepath.Join(pluginDir, "requests"))), before), "\n") {
		if fields := strings.Fields(line); len(fields) == 2 && fields[0] != wantPID {
			t.Fatalf("old process served after handoff: %s", line)
		}
	}
	stopTestCore(t, c)
	store := recoveryStore(t, dir)
	records, err := store.Journals(t.Context(), "recovery")
	if err != nil || len(records) != 2 || records[1].Phase != "committed" || records[1].NewGeneration != item.Active {
		t.Fatalf("gate journal: %+v %v", records, err)
	}
	t.Logf("gates %s: old=%s new=%s pid=%s requests=%s Journal=%+v", phase, old, item.Active, wantPID, scenarioRecoveryRead(t, filepath.Join(pluginDir, "requests")), records)
}

func scenarioRecoveryDirectory(t *testing.T, name string) string {
	t.Helper()
	dir := filepath.Join(os.Getenv("ALONABOT_SCENARIO_DATA_DIR"), name)
	if err := os.Mkdir(dir, 0o700); err != nil {
		t.Fatal(err)
	}
	scenarioRecord(t, "subcase", map[string]string{"name": name, "directory": dir})
	return dir
}

func scenarioRecoveryStart(t *testing.T, binary, dir, phase string) *core {
	t.Helper()
	c := startRecoveryCore(t, binary, dir, phase)
	t.Cleanup(func() {
		_ = c.cmd.Process.Kill()
		<-c.done
		scenarioRecord(t, "core-log", map[string]string{"directory": dir, "phase": phase, "log": c.log()})
	})
	return c
}

func scenarioRecoveryRead(t *testing.T, name string) []byte {
	t.Helper()
	raw, err := os.ReadFile(name)
	if err != nil {
		t.Fatal(err)
	}
	return raw
}

func scenarioRecoveryBuild(t *testing.T) {
	t.Helper()
	dir := os.Getenv("ALONABOT_SCENARIO_OUT")
	binary, plugin, probe := scenarioRecoveryFaultFixture(t, dir)
	for id, executable := range map[string]string{"recovery": plugin, "gateprobe": probe} {
		packageDir := filepath.Join(dir, id)
		if err := os.Mkdir(packageDir, 0o700); err != nil {
			t.Fatal(err)
		}
		manifest := fmt.Sprintf("manifest_version: 1\nid: %s\nname: Recovery Fixture\nversion: 1.0.0\nsource: github.com/example/%s\nrole: plugin\nprotocol_min_major: 1\nprotocol_max_major: 1\nrequired_capabilities: []\nentrypoint: bin/component\nmigration_mode: none\nprepare_effects: managed_db\nos: %s\narch: %s\n", id, id, runtime.GOOS, runtime.GOARCH)
		archive, err := writeTestPackage(packageDir, id, "plugin", "", "github.com/example/"+id, "1.0.0", executable, "", map[string][]byte{"plugin.yaml": []byte(manifest)})
		if err != nil {
			t.Fatal(err)
		}
		scenarioRecord(t, "built-package", archive)
	}
	adapterFile := filepath.Join(dir, "adapter.go")
	scenarioRecoveryWrite(t, adapterFile, adapterFixtureSource)
	adapterBinary := filepath.Join(dir, "adapter")
	command := exec.Command("go", fixtureBuildArgs("-overlay", filepath.Join(dir, "fault-overlay.json"), "-o", adapterBinary, adapterFile)...)
	if output, err := command.CombinedOutput(); err != nil {
		t.Fatalf("build adapter: %v\n%s", err, output)
	}
	adapterDir := filepath.Join(dir, "adapter-package")
	if err := os.Mkdir(adapterDir, 0o700); err != nil {
		t.Fatal(err)
	}
	archive, err := writeTestPackage(adapterDir, "alonabot-adapter-fixture", "adapter", "devloop", "github.com/example/adapter", "1.0.0", adapterBinary, "", map[string][]byte{"adapter_config_schema.json": []byte(`{}`)})
	if err != nil {
		t.Fatal(err)
	}
	scenarioRecord(t, "built-package", archive)
	scenarioRecord(t, "built-overlay-core", binary)
}
