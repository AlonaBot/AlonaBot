func scenarioRecoveryFaultFixture(t *testing.T, dir string) (string, string, string) {
	t.Helper()
	_, _ = buildRecoveryFixture(t, dir)
	var overlay struct{ Replace map[string]string }
	if err := json.Unmarshal(scenarioRecoveryRead(t, filepath.Join(dir, "overlay.json")), &overlay); err != nil {
		t.Fatal(err)
	}
	patch := func(name, anchor, replacement string) {
		t.Helper()
		original, err := filepath.Abs(filepath.Join("../..", name))
		if err != nil {
			t.Fatal(err)
		}
		input := original
		if modified := overlay.Replace[original]; modified != "" {
			input = modified
		}
		source := string(scenarioRecoveryRead(t, input))
		if strings.Count(source, anchor) != 1 {
			t.Fatalf("ambiguous fault observation point: %s %s", name, anchor)
		}
		modified := filepath.Join(dir, strings.ReplaceAll(name, "/", "_"))
		scenarioRecoveryWrite(t, modified, strings.Replace(source, anchor, replacement, 1))
		overlay.Replace[original] = modified
	}
	patch("internal/core/journal/commit.go", " select {}", `
 if _, err := os.Stat(os.Getenv("ALONABOT_TEST_CHECKPOINT")+".release"); err == nil {
  if _,err:=os.ReadFile(os.Getenv("ALONABOT_TEST_CHECKPOINT")+".release");err!=nil{panic(err)}
  return
 } else if !os.IsNotExist(err) {panic(err)}
 select {}`)
	patch("internal/app/assembly.go", "if attachErr := a.attach(ctx, running); attachErr != nil {", `if os.Getenv("ALONABOT_TEST_CRASH_PHASE")=="binding"&&id=="recovery"{
  name:=os.Getenv("ALONABOT_TEST_CHECKPOINT");if err:=os.WriteFile(name,[]byte("binding"),0600);err!=nil{panic(err)}
  if _,err:=os.ReadFile(name+".release");err!=nil{panic(err)}
 }
 if attachErr := a.attach(ctx, running); attachErr != nil {`)
	raw, err := json.Marshal(overlay)
	if err != nil {
		t.Fatal(err)
	}
	path := filepath.Join(dir, "fault-overlay.json")
	scenarioRecoveryWrite(t, path, string(raw))
	// 观测与候选写入只进入临时插件；原恢复插件的数据库及故障入口继续复用。
	source := strings.Replace(recoveryFixtureSource, "\"os\"", "\"os\"\n\"time\"\n\"github.com/AlonaBot/AlonaBot/sdk/service\"\n\"github.com/AlonaBot/AlonaBot/sdk/bus\"", 1)
	source = strings.Replace(source, "func main() {", `type gateArgs struct{}
func observe(kind string)error{f,err:=os.OpenFile("requests",os.O_CREATE|os.O_APPEND|os.O_WRONLY,0600);if err!=nil{return err};_,err=fmt.Fprintf(f,"%d %s\n",os.Getpid(),kind);closeErr:=f.Close();if err!=nil{return err};return closeErr}
func main() {`, 1)
	source = strings.Replace(source, "genimpl.Resources{}", `genimpl.Resources{ServiceSchemas:map[string][]byte{"main.gateArgs":[]byte("{\"type\":\"object\"}")}}`, 1)
	source = strings.Replace(source, "p:=sdk.NewPlugin()", `p:=sdk.NewPlugin()
 p.Command("gate").Handle(func(*sdk.Context)error{return observe("command")})
 p.On(sdk.MessageCreated).Rule(sdk.NotCommand()).Handle(func(*sdk.Context)error{return observe("event")})
 service.Serve(p,service.JSON[gateArgs,gateArgs]("recovery/gate")).Access(service.AccessPublic).Handle(func(*sdk.Context,gateArgs)(gateArgs,error){return gateArgs{},observe("service")})
 bus.Subscribe(p,bus.Define[gateArgs]("gateprobe/pulse")).Handle(func(*sdk.Context,gateArgs)error{return observe("bus")})
 p.Every("gate",time.Second).Handle(func(*sdk.Context)error{return observe("job")})
`, 1)
	source = strings.Replace(source, "file,err:=os.OpenFile(\"starts\"", `if raw,err:=os.ReadFile("candidate-value");err==nil{if _,err=db.ExecContext(ctx,"UPDATE value SET n=? WHERE id=1",string(raw));err!=nil{return err}}else if !os.IsNotExist(err){return err}
  file,err:=os.OpenFile("starts"`, 1)
	source = strings.Replace(source, "p.OnReady(func(context.Context)error{", `p.OnReady(func(context.Context)error{slog.Info("OnReady");`, 1)
	source = strings.Replace(source, "db,err:=sqlitedb.Open(r.Context());if err!=nil", `if err:=observe("http");err!=nil{http.Error(w,err.Error(),500);return};db,err:=sqlitedb.Open(r.Context());if err!=nil`, 1)
	pluginFile := filepath.Join(dir, "observed-plugin.go")
	scenarioRecoveryWrite(t, pluginFile, source)
	probeFile := filepath.Join(dir, "probe.go")
	scenarioRecoveryWrite(t, probeFile, scenarioRecoveryProbeSource)
	coreBinary, pluginBinary, probeBinary := filepath.Join(dir, "fault-core"), filepath.Join(dir, "observed-plugin"), filepath.Join(dir, "probe")
	for _, build := range [][2]string{{coreBinary, "."}, {pluginBinary, pluginFile}, {probeBinary, probeFile}} {
		if output, err := exec.Command("go", fixtureBuildArgs("-overlay", path, "-o", build[0], build[1])...).CombinedOutput(); err != nil {
			t.Fatalf("build fault fixture: %v\n%s", err, output)
		}
	}
	return coreBinary, pluginBinary, probeBinary
