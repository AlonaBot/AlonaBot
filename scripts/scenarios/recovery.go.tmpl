// TestScenarioRecovery 驱动指定产物，保留恢复与门禁的实际状态。
func TestScenarioRecovery(t *testing.T) {
	if os.Getenv("ALONABOT_SCENARIO_MODE") == "build-recovery" {
		scenarioRecoveryBuild(t)
		return
	}
	binary := os.Getenv("ALONABOT_SCENARIO_OVERLAY_CORE")
	v1 := os.Getenv("ALONABOT_SCENARIO_RECOVERY_PACKAGE")
	probe := os.Getenv("ALONABOT_SCENARIO_PROBE_PACKAGE")
	install := func(t *testing.T, c *core, dir string) string {
		t.Helper()
		scenarioManagement(t, c, dir, "", "install", v1, "--yes")
		scenarioManagement(t, c, dir, "", "enable", "recovery")
		scenarioRecoveryWrite(t, filepath.Join(dir, "plugins", "recovery", "config.json"), "{}")
		scenarioRecoveryValue(t, c, dir, "41", true)
		return scenarioPackage(t, c, dir, "recovery").Active
	}
	for _, phase := range []string{"prepared", "committed", "first-prepared"} {
		t.Run(phase, func(t *testing.T) {
			// 1. 候选写入不同的真实 DB 值，使提交两侧的恢复结果可直接区分。
			dir := scenarioRecoveryDirectory(t, phase)
			pluginDir := filepath.Join(dir, "plugins", "recovery")
			c := scenarioRecoveryStart(t, binary, dir, "")
			old := ""
			if phase == "first-prepared" {
				scenarioManagement(t, c, dir, "", "install", v1, "--yes")
			} else {
				old = install(t, c, dir)
			}
			stopTestCore(t, c)
			checkpoint := strings.TrimPrefix(phase, "first-")
			c = scenarioRecoveryStart(t, binary, dir, checkpoint)
			c.address()
			if old != "" {
				c.waitFor(`"msg":"plugin activated"`)
			}
			if err := os.MkdirAll(pluginDir, 0o700); err != nil {
				t.Fatal(err)
			}
			scenarioRecoveryWrite(t, filepath.Join(pluginDir, "candidate-value"), "77")
			action := "reload"
			if old == "" {
				action = "enable"
			}
			request := scenarioRecoveryStartCommand(t, recoveryCommand(t, c, dir, action, "recovery"))
			scenarioRecoveryWaitFile(t, filepath.Join(dir, "checkpoint"))
			scenarioRecoveryKillCore(t, c)
			if result := request.wait(t); result.err == nil {
				t.Fatalf("interrupted %s succeeded: %s", action, result.output)
			}
			waitRecoveryRuntime(t, pluginDir)
			// 2. Core 退出后检查提交指针、候选引用与两个库的实际内容。
			store := recoveryStore(t, dir)
			records, err := store.Journals(t.Context(), "recovery")
			wantRecords := 2
			if old == "" {
				wantRecords = 1
			}
			if err != nil || len(records) != wantRecords {
				t.Fatalf("crash journals: %+v %v", records, err)
			}
			operation := records[len(records)-1]
			wantActive := old
			if checkpoint == "committed" {
				wantActive = operation.NewGeneration
			}
			active, err := store.Active(t.Context(), "recovery")
			if err != nil || active != wantActive || operation.ExpectedOld != old || operation.Phase != checkpoint || operation.DatabasePath == "" || len(operation.SessionID) == 0 {
				t.Fatalf("crash authority: Active=%s journal=%+v error=%v", active, operation, err)
			}
			scenarioRecoveryDatabase(t, operation.DatabasePath, "77")
			if old != "" {
				scenarioRecoveryDatabase(t, filepath.Join(pluginDir, "generations", old, "db.sqlite"), "41")
			}
			scenarioRecoveryJournalResources(t, store, dir, operation, true)
			t.Logf("crash %s: Active=%s Journal=%+v", phase, active, operation)
			if err := store.Close(); err != nil {
				t.Fatal(err)
			}
			if err := os.Remove(filepath.Join(pluginDir, "candidate-value")); err != nil {
				t.Fatal(err)
			}
			// 3. 恢复只选择提交点指定的代次；首装未提交时保持未激活。
			c = scenarioRecoveryStart(t, binary, dir, "")
			item := scenarioPackage(t, c, dir, "recovery")
			if item.Active != wantActive || old == "" && (item.Enabled || item.State == "Activated") {
				t.Fatalf("recovered package: %+v; want %s", item, wantActive)
			}
			if old != "" {
				value := "41"
				if checkpoint == "committed" {
					value = "77"
				}
				scenarioRecoveryValue(t, c, dir, value, false)
				if strings.Count(c.log(), `"msg":"plugin activated"`) != 1 || lastSession(t, c) == hex.EncodeToString(operation.SessionID) {
					t.Fatalf("recovery did not create one new Session: %s", c.log())
				}
			} else if status, body := scenarioHTTP(t, c, dir, http.MethodGet, "/plugins/recovery/value"); status != 503 {
				t.Fatalf("uncommitted first install served: %d %s", status, body)
			}
			stopTestCore(t, c)
			store = recoveryStore(t, dir)
			recovered, err := store.GetJournal(t.Context(), operation.OpID)
			wantPhase := "cleaned"
			if checkpoint == "committed" {
				wantPhase = "committed"
			}
			if err != nil || recovered.Phase != wantPhase {
				t.Fatalf("recovered operation: %+v %v", recovered, err)
			}
			scenarioRecoveryJournalResources(t, store, dir, operation, checkpoint == "committed")
			t.Logf("recovered %s: %+v", phase, recovered)
		})
	}
	t.Run("ready", func(t *testing.T) {
		dir := scenarioRecoveryDirectory(t, "ready")
		pluginDir := filepath.Join(dir, "plugins", "recovery")
		c := scenarioRecoveryStart(t, binary, dir, "")
		old := install(t, c, dir)
		scenarioRecoveryWrite(t, filepath.Join(pluginDir, "candidate-value"), "77")
		scenarioRecoveryWrite(t, filepath.Join(pluginDir, "fail-ready"), "")
		output, err := recoveryCommand(t, c, dir, "reload", "recovery").CombinedOutput()
		if err == nil || !strings.Contains(string(output)+c.log(), "fixture ready failed") {
			t.Fatalf("OnReady failure: %v %s\n%s", err, output, c.log())
		}
		current := scenarioPackage(t, c, dir, "recovery")
		if current.Active == old || current.State != "Degraded" || !current.Enabled {
			t.Fatalf("OnReady authority: %+v", current)
		}
		if status, body := scenarioHTTP(t, c, dir, http.MethodGet, "/plugins/recovery/value"); status != 503 {
			t.Fatalf("OnReady failure served: %d %s", status, body)
		}
		t.Logf("OnReady rejection: %s\n%s", output, c.log())
		scenarioRecoveryKillCore(t, c)
		waitRecoveryRuntime(t, pluginDir)
		store := recoveryStore(t, dir)
		records, err := store.Journals(t.Context(), "recovery")
		if err != nil || len(records) != 2 || records[1].Phase != "committed" || records[1].NewGeneration != current.Active {
			t.Fatalf("OnReady journal: %+v %v", records, err)
		}
		scenarioRecoveryDatabase(t, records[1].DatabasePath, "77")
		scenarioRecoveryDatabase(t, filepath.Join(pluginDir, "generations", old, "db.sqlite"), "41")
		if err := store.Close(); err != nil {
			t.Fatal(err)
		}
		if err := os.Remove(filepath.Join(pluginDir, "candidate-value")); err != nil {
			t.Fatal(err)
		}
		c = scenarioRecoveryStart(t, binary, dir, "")
		c.waitFor("fixture ready failed")
		if item := scenarioPackage(t, c, dir, "recovery"); item.Active != current.Active || item.State != "Degraded" {
			t.Fatalf("failed resume changed authority: %+v", item)
		}
		stopTestCore(t, c)
		if err := os.Remove(filepath.Join(pluginDir, "fail-ready")); err != nil {
			t.Fatal(err)
		}
		c = scenarioRecoveryStart(t, binary, dir, "")
		c.waitFor(`"msg":"plugin activated"`)
		if item := scenarioPackage(t, c, dir, "recovery"); item.Active != current.Active || item.State != "Activated" {
			t.Fatalf("repaired resume: %+v", item)
		}
		scenarioRecoveryValue(t, c, dir, "77", false)
		stopTestCore(t, c)
		store = recoveryStore(t, dir)
		records, err = store.Journals(t.Context(), "recovery")
		if err != nil || len(records) != 2 || records[1].Phase != "committed" {
			t.Fatalf("resume created a candidate: %+v %v", records, err)
		}
		t.Logf("repaired Active=%s Journal=%+v", current.Active, records)
	})
	for _, phase := range []string{"prepared", "committed", "binding"} {
		t.Run("gates-"+phase, func(t *testing.T) { scenarioRecoveryCandidateGates(t, binary, v1, probe, phase) })
	}
}

func scenarioRecoveryWrite(t *testing.T, name, value string) {
	t.Helper()
	if err := os.WriteFile(name, []byte(value), 0o600); err != nil {
		t.Fatal(err)
	}
}

func scenarioRecoveryWaitFile(t *testing.T, name string) {
	t.Helper()
	recoveryWait(t, func() bool {
		_, err := os.Stat(name)
		if err != nil && !errors.Is(err, os.ErrNotExist) {
			t.Fatal(err)
		}
		return err == nil
	})
}

func scenarioRecoveryValue(t *testing.T, c *core, dir, value string, write bool) {
	t.Helper()
	if write {
		if status, raw := scenarioHTTP(t, c, dir, http.MethodPut, "/plugins/recovery/value?n="+value); status != 204 {
			t.Fatalf("write value: %d %s", status, raw)
		}
	}
	if status, raw := scenarioHTTP(t, c, dir, http.MethodGet, "/plugins/recovery/value"); status != 200 || string(raw) != value {
		t.Fatalf("read value: %d %s; want %s", status, raw, value)
	}
}

func scenarioRecoveryDatabase(t *testing.T, name, want string) {
	t.Helper()
	db, err := sql.Open("sqlite", "file:"+name+"?mode=ro")
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := db.Close(); err != nil {
			t.Error(err)
		}
	}()
	var value string
	if err := db.QueryRow("SELECT n FROM value WHERE id=1").Scan(&value); err != nil || value != want {
		t.Fatalf("database %s: %s %v; want %s", name, value, err, want)
	}
}

func scenarioRecoveryJournalResources(t *testing.T, store *state.Store, dir string, record state.Journal, present bool) {
	t.Helper()
	references, err := store.ReferencedGenerations(t.Context(), "recovery")
	if err != nil || slices.Contains(references, record.NewGeneration) != present {
		t.Fatalf("generation references: %v %v; Journal=%+v", references, err, record)
	}
	name := filepath.Join(dir, "plugins", "recovery", "generations", record.NewGeneration, "db.sqlite")
	_, err = os.Stat(name)
	if present && err != nil || !present && !errors.Is(err, os.ErrNotExist) {
		t.Fatalf("candidate resource %s present=%t: %v", name, present, err)
	}
	scenarioRecord(t, "resources", map[string]any{"directory": dir, "candidate": record, "references": references, "database_present": present})
}

func scenarioRecoveryKillCore(t *testing.T, c *core) {
	t.Helper()
	if err := c.cmd.Process.Kill(); err != nil {
		t.Fatal(err)
	}
	<-c.done
}

// scenarioRecoveryCommandProcess 在 done 关闭后交付输出，避免观测检查点时并发读取缓冲区。
type scenarioRecoveryCommandProcess struct {
	done   chan struct{}
	args   []string
	output []byte
	err    error
}

func scenarioRecoveryStartCommand(t *testing.T, command *exec.Cmd) *scenarioRecoveryCommandProcess {
	t.Helper()
	var output bytes.Buffer
	command.Stdout, command.Stderr = &output, &output
	if err := command.Start(); err != nil {
		t.Fatal(err)
	}
	p := &scenarioRecoveryCommandProcess{done: make(chan struct{}), args: command.Args}
	go func() {
		p.err = command.Wait()
		p.output = output.Bytes()
		close(p.done)
	}()
	t.Cleanup(func() { _ = command.Process.Kill(); <-p.done })
	return p
}

func (p *scenarioRecoveryCommandProcess) wait(t *testing.T) *scenarioRecoveryCommandProcess {
	t.Helper()
	recoveryWait(t, func() bool {
		select {
		case <-p.done:
			return true
		default:
			return false
		}
	})
	scenarioRecord(t, "cli-process", map[string]any{"args": p.args, "output": string(p.output), "error": fmt.Sprint(p.err)})
	return p
}

